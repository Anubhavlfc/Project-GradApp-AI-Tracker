# Copy to .env.local (never commit it). See docs/supabase-setup.md for where to find these.
#
# Only PUBLIC values belong here: everything named VITE_* is copied into the JavaScript that every
# visitor downloads. Never put a service_role / secret key in these variables; the build fails if
# it detects one.
VITE_SUPABASE_URL=
# The publishable key (sb_publishable_...) or the legacy "anon" key.
VITE_SUPABASE_ANON_KEY=
